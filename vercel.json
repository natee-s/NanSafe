{
  "version": 2,
  "builds": [
    {
      "src": "app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/live-waterlevel",
      "dest": "https://api-v3.thaiwater.net/api/v1/thaiwater30/public/waterlevel_load?province_code=55"
    },
    {
      "src": "/live-waterlevel-history/(\\d+)",
      "dest": "https://api-v3.thaiwater.net/api/v1/thaiwater30/iframe/waterlevel_graph?station_type=tele_waterlevel&id=$1"
    },
    {
      "src": "/data/(.*)",
      "dest": "/app/data/$1"
    },
    {
      "src": "/app.js",
      "dest": "/app/app.js"
    },
    {
      "src": "/styles.css",
      "dest": "/app/styles.css"
    },
    {
      "src": "/sw.js",
      "dest": "/app/sw.js"
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/app/manifest.webmanifest"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }]
    }
  ]
}
